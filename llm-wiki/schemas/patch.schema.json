{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pasta.local/llm-wiki/patch.schema.json",
  "title": "LLM Wiki Patch v1",
  "type": "object",
  "required": [
    "version",
    "job_id",
    "operation",
    "page",
    "evidence_record_ids",
    "content",
    "jd_id"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "const": "upsert"
    },
    "page": {
      "type": "string",
      "pattern": "^\\.llm-wiki/generated/[0-9]{2}\\.[0-9]{2}/[^/].*\\.md$"
    },
    "evidence_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "jd_id": {
      "type": "string",
      "pattern": "^[0-9]{2}\\.[0-9]{2}$"
    }
  },
  "additionalProperties": false
}
