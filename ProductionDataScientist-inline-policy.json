{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAndDescribeStateMachines",
      "Effect": "Allow",
      "Action": [
        "states:ListStateMachines",
        "states:ListActivities"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageSpecificTrainingStateMachines",
      "Effect": "Allow",
      "Action": [
        "states:DescribeStateMachine",
        "states:DescribeStateMachineForExecution",
        "states:ListExecutions",
        "states:StartExecution",
        "states:StopExecution",
        "states:DescribeExecution",
        "states:GetExecutionHistory",
        "states:UpdateStateMachine",
        "states:CreateStateMachine",
        "states:PublishStateMachineVersion",
        "states:CreateStateMachineAlias",
        "states:UpdateStateMachineAlias",
        "states:RedriveExecution"
      ],
      "Resource": [
        "arn:aws:states:eu-central-1:027771791665:stateMachine:UserclusteringV2Weeklypipeline",
        "arn:aws:states:eu-central-1:027771791665:execution:UserclusteringV2Weeklypipeline:*",
        "arn:aws:states:eu-central-1:027771791665:stateMachine:CTRpredictor-and-UserClustering-weekly-training",
        "arn:aws:states:eu-central-1:027771791665:execution:CTRpredictor-and-UserClustering-weekly-training:*",
        "arn:aws:states:eu-central-1:027771791665:stateMachine:StepFunction-category-percentage-per-location",
        "arn:aws:states:eu-central-1:027771791665:execution:StepFunction-category-percentage-per-location:*"
      ]
    },
    {
      "Sid": "AllowPassRoleToStepFunctionsOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::027771791665:role/service-role/StepFunctions-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "states.amazonaws.com"
        }
      }
    },
    {
      "Sid": "IAMCreateForLambdaAndStepFunctions",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:AttachRolePolicy",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:TagPolicy",
        "iam:GetRole",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListRoles",
        "iam:ListPolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassRoleToLambdaAndSageMaker",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "sagemaker.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "S3ListBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "S3CreateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutBucketPolicy",
        "s3:PutBucketTagging",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::readpeak-*"
    },
    {
      "Sid": "S3ReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:GetObjectTagging",
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::readpeak-prophet-trainingdata",
        "arn:aws:s3:::readpeak-prophet-trainingdata/*",
        "arn:aws:s3:::readpeak-data-lake",
        "arn:aws:s3:::readpeak-data-lake/*",
        "arn:aws:s3:::readpeak-ctr-predictor-stepfunction",
        "arn:aws:s3:::readpeak-ctr-predictor-stepfunction/*",
        "arn:aws:s3:::readpeak-ctr-predictor-models",
        "arn:aws:s3:::readpeak-ctr-predictor-models/*",
        "arn:aws:s3:::readpeak-ml-data-files",
        "arn:aws:s3:::readpeak-ml-data-files/*",
        "arn:aws:s3:::readpeak-redshift-data",
        "arn:aws:s3:::readpeak-redshift-data/*",
        "arn:aws:s3:::readpeak-redshift-data-by-day",
        "arn:aws:s3:::readpeak-redshift-data-by-day/*",
        "arn:aws:s3:::readpeak-clickhouse-data/*",
        "arn:aws:s3:::aws-athena-query-results-027771791665-eu-central-1",
        "arn:aws:s3:::aws-athena-query-results-027771791665-eu-central-1/*"
      ]
    },
    {
      "Sid": "AthenaAccess",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution",
        "athena:ListWorkGroups"
      ],
      "Resource": "arn:aws:athena:*:027771791665:workgroup/*"
    },
    {
      "Sid": "GlueCatalogRead",
      "Effect": "Allow",
      "Action": [
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetPartition",
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:glue:*:027771791665:catalog",
        "arn:aws:glue:*:027771791665:database/*",
        "arn:aws:glue:*:027771791665:table/*/*"
      ]
    },
    {
      "Sid": "RedshiftDataRead",
      "Effect": "Allow",
      "Action": [
        "redshift-data:ExecuteStatement",
        "redshift-data:GetStatementResult",
        "redshift-data:DescribeStatement",
        "redshift-data:ListStatements",
        "redshift:GetClusterCredentials",
        "redshift:DescribeClusters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SageMakerTraining",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreateProcessingJob",
        "sagemaker:CreateTrainingJob",
        "sagemaker:DescribeProcessingJob",
        "sagemaker:DescribeTrainingJob",
        "sagemaker:ListProcessingJobs",
        "sagemaker:ListTrainingJobs"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyAllDeletes",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteBucket",
        "s3:DeleteObjectVersion",
        "glue:DeleteDatabase",
        "glue:DeleteTable",
        "glue:DeletePartition",
        "redshift:DeleteCluster",
        "sagemaker:DeleteEndpoint",
        "sagemaker:DeleteModel",
        "iam:DeleteRole",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "lambda:DeleteFunction",
        "states:DeleteStateMachine",
        "states:DeleteStateMachineAlias",
        "states:DeleteStateMachineVersion"
      ],
      "Resource": "*"
    }
  ]
}
